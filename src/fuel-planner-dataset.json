{
  "_meta": {
    "purpose": "Data for the AW169 IFR Fuel Planner tab. Bundled into the app at build — no runtime network needed. All computed on-device.",
    "verify_before_trust": "PinS approach status values (planned/confirm) are placeholders to confirm. East Brighton Park position supplied by the user (50.8174, -0.1018). Airfield coordinates = published ARP (verify vs current eAIP). Hospital coords = approximate location (verify). Approach DH values = OMA 8H system-minima FLOORS by type, NOT published airfield OCH — actual DH comes from the company plate and is usually higher. AIRAC-dated when approach selection goes live.",
    "sources": "OMA Part A Iss7 Rev1 Aug2026 §8H; OMB Part B34 AW169 Iss1 Rev1 May2026 §5; UK eAIP (NATS Aurora)."
  },

  "aircraft": {
    "type": "AW169",
    "usable_fuel_kg": 904,
    "fuel_density_kg_per_l": 0.79,
    "plan_speed_kt": 130,
    "cruise_burn_kg_per_hr": 280,
    "cruise_burn_85pct_kg_per_hr": 320,
    "cruise_burn_95pct_kg_per_hr": 340,
    "holding_speed_kt": 100,
    "single_engine_burn_kg_per_hr": 180,
    "start_taxi_default_kg": 30,
    "final_reserve_ifr_kg": 150,
    "final_reserve_vfr_day_kg": 100,
    "per_ifr_approach_kg": 70,
    "engine_failure_hold_min": 15,
    "engine_failure_hold_kg_derived": 75,
    "mtom_kg": 4800
  },

  "oma_rules": {
    "contingency_pct_ifr": 10,
    "scenario_A_trip_add_min": 15,
    "scenarios": {
      "VMC":  { "label": "VMC at destination",        "alternates": 0, "approaches_default": 1, "alt_fuel": false, "gating": { "dest_vmc_window_hr": 1 } },
      "A":    { "label": "2 approaches, 1 field",       "alternates": 0, "approaches_default": 2, "alt_fuel": false, "trip_add_min": 15, "gating": { "ceiling_above_minima_ft": 400, "vis_min_m": 3000, "independent_aids": true } },
      "B":    { "label": "1 alternate",                 "alternates": 1, "approaches_default": 2, "alt_fuel": true,  "altn_minima": { "rvr_vis_add_m": 400, "ceiling_add_ft": 200 } },
      "C":    { "label": "1 alternate (reasonable prob)","alternates": 1, "approaches_default": 2, "alt_fuel": true,  "altn_minima": { "rvr_vis_add_m": 800, "ceiling_add_ft": 400 } },
      "D":    { "label": "2 alternates",                "alternates": 2, "approaches_default": 3, "alt_fuel": true,  "altn_rule": "plan to worse of the two" },
      "VFR":  { "label": "VFR leg (day)",               "alternates": 0, "approaches_default": 0, "alt_fuel": false, "ifr": false, "final_reserve": "final_reserve_vfr_day_kg", "contingency": "same as IFR sectors (user decision Nov 2026)" }
    },
    "gnss_approach_types": ["RNP_LNAV", "RNP_LNAV_VNAV", "LPV", "PinS"],
    "alternate_validity": { "rule": "valid only if a non-GNSS approach exists at the alternate or at the destination", "ref": "OMA 8H 8.1.3.3.2; PinS: 8.3.2.7.4" },
    "profiles_by_destination": {
      "pins":               { "allowed": ["C", "D", "VFR"], "default": "C", "ref": "OMA 8H 8.3.2.7.4 / 8.3.2.7.7 — alternate always carried; site weather uncertified so B not valid" },
      "airfield":           { "allowed": ["VMC", "A", "B", "C", "D", "VFR"], "default": "B", "ref": "OMA 8H 8.1.3.3.2" },
      "airfield_one_aid":   { "allowed": ["VMC", "B", "C", "D", "VFR"], "default": "B", "note": "A needs two approaches on independent aids" }
    },
    "multi_sector": {
      "contingency": "10% of each sector's trip fuel, treated as burnt on that sector; nothing of it is assumed left for the next leg (CONFIRMED by Ed, Nov 2026)",
      "approach_per_arrival": 1,
      "default_alternate": "nearest valid alternate to the sector destination; user may change",
      "refuel_stop": "only at sites with fuel; uplift to at least the minimum to lift; breaks the chain"
    }
  },

  "approach_system_minima_floor_ft": {
    "ILS": 200, "LPV": 200, "PAR": 200,
    "RNP_LNAV": 250, "RNP_LNAV_VNAV": 250, "PinS": 250, "LOC": 250, "VOR_DME": 250,
    "VOR": 300, "NDB_DME": 300, "NDB": 350,
    "SRA_half_nm": 250, "SRA_1_nm": 300, "SRA_2_nm": 350
  },

  "rvr_by_dh_band_m": {
